# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`
.DS_Store
# Ignore bundler config.
/.bundle

# Ignore all environment files, except the committed template.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key


/app/assets/builds/*
!/app/assets/builds/.keep

/node_modules
/design-webui-inspiration
CLAUDE.local.md
tmp

# The licence signing key. NEVER committed — the public half in
# config/license/public_key.pem ships in the image and is what verifies; this
# half mints licences, so anyone holding it can issue their own. Ignored by
# pattern rather than by filename so a rename does not quietly un-ignore it,
# and test/architecture/no_private_keys_test.rb fails the build if one ever
# lands in git anyway.
/config/license/*private*
*.private.pem
