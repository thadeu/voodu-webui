# voodu-webui — environment template.
#
#   cp .env.example .env      # edit, then: docker compose up -d
#
# Every knob here has a working default — an untouched copy of this file
# boots the dashboard on http://<host>/ with no certificate and no login.
# TLS and Basic Auth are opt-in, one block each.

# ── Host ports ─────────────────────────────────────────────────────────
# Host side of the published ports. Inside the container the app always
# listens on 3000 (HTTP — also where the image HEALTHCHECK curls /up) and
# on 443 (HTTPS). Keep the HTTP one on 80: the Let's Encrypt HTTP-01
# challenge lands there, and Thruster redirects the rest to HTTPS.
# These replace the older HOST_PORT (still read as a fallback for the HTTP
# one). A legacy HOST_PORT=443 now collides with the HTTPS mapping: remove
# it and set TLS_DOMAIN below, which is what 443 is for.
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443

# ── TLS ────────────────────────────────────────────────────────────────
# Domain that points at this host. Thruster (bundled in the image) gets a
# Let's Encrypt certificate for it, renews it, and redirects HTTP->HTTPS.
# With the Basic Auth overlay (docker-compose.auth.yml) Caddy does this job
# instead, reading the same variable.
#
# Set it only when all three are true:
#   1. An A/AAAA record for the name resolves to this host
#   2. Host ports 80 AND 443 are open (80 = ACME HTTP-01 challenge)
#   3. Nothing else terminates TLS in front (a Cloudflare orange-cloud
#      proxy breaks HTTP-01 — use DNS-only, or leave this empty and let
#      Cloudflare hold the certificate)
#
# Certificates persist in the storage volume (/rails/storage/thruster), so
# a restart does not re-request them.
#
# EMPTY = plain HTTP, no certificate. A name that does not resolve to this
# host makes the site unreachable: the HTTPS listener has no certificate
# and HTTP only answers with a redirect to it.
TLS_DOMAIN=
# TLS_DOMAIN=console.example.com

# Let's Encrypt staging directory. Use it while DNS or the firewall is
# still wrong — failures there do not burn the production rate limit. The
# browser warns about an untrusted certificate; that is expected.
# ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory

# ── Basic Auth ─────────────────────────────────────────────────────────
# The dashboard has no login screen of its own. The auth overlay puts
# Caddy in front: it terminates TLS, asks for user + password, and proxies
# to the app over the private compose network (the app stops publishing
# ports and stops doing its own TLS).
#
#   docker compose -f docker-compose.yml -f docker-compose.auth.yml up -d
#
# ...or uncomment COMPOSE_FILE and keep typing plain `docker compose up -d`:
# COMPOSE_FILE=docker-compose.yml:docker-compose.auth.yml
#
# The password is plain text here and gets bcrypt-hashed at container boot,
# so rotating it is: edit the line, `docker compose up -d`. /up stays open
# so healthchecks and uptime monitors do not need credentials.
BASIC_AUTH_USER=voodu
BASIC_AUTH_PASSWORD=change-me

# ── Operator sign-in ───────────────────────────────────────────────────
# OFF by default on a FRESH install. Leave CLOWK_ENABLED unset and the app asks
# for no credentials: every request runs as one local operator with owner rights.
#
# One exception, and it exists so upgrades cannot remove authentication: if
# CLOWK_PUBLISHABLE_KEY is set and CLOWK_ENABLED is not, sign-in stays ON. An
# install already configured for Clowk is one where somebody chose sign-in.
# To go anonymous while keeping the key around, say so with CLOWK_ENABLED=0.
#
# READ THIS BEFORE PUBLISHING THE PORT. Owner rights include reading each
# server's access token, and that token IS the controller — deploy, exec,
# logs, on every box this dashboard manages. Anonymous mode assumes something
# in front of it already authenticated the caller: Twingate, WireGuard, an
# access proxy, an SSH tunnel. That is a good arrangement and it is the one
# this default is built for. Publishing 3000 to the internet with sign-in off
# does not leak a dashboard, it hands over the infrastructure.
#
# The app says so itself: a warning at boot in `docker logs`, and a banner on
# every page once a request arrives from a public address.
#
# CLOWK_ENABLED=1

# If your access proxy forwards the real public client IP (Cloudflare Access
# does; Twingate and most VPNs do not), the banner cannot tell that apart from
# an open port. Set this to state that the perimeter is there.
# VOODU_TRUSTED_PERIMETER=1

# ── Operator sign-in with Clowk.in (CLOWK_ENABLED=1) ───────────────────
# Turns on per-person identity: accounts, orgs, invitations, per-server
# grants. This is what a multi-tenant deployment wants — several people, each
# reaching only what a membership grants them.
#
# CLOWK_PUBLISHABLE_KEY is then the only one you must set: the Clowk instance,
# its JWKS endpoint and the token audience all derive from it. With the flag
# on and this missing, the app refuses to boot rather than start unprotected.
# Commented on purpose: dotenv loads this file in DEVELOPMENT too, and a
# placeholder key is worse than none — the app would try to resolve a Clowk
# instance that does not exist instead of falling back to /dev/sign_in.
# Uncomment with your real key for production.
# CLOWK_PUBLISHABLE_KEY=pk_live_...

# Optional. Clowk signs with RS256 and the app verifies against the public
# JWKS, so sign-in works without it. Supply it only for tokens minted before
# Clowk's RS256 migration, or to switch enforce_active_session on.
# CLOWK_SECRET_KEY=sk_live_...

# In development and test neither is needed: the app falls back to a local
# secret and `/dev/sign_in?email=you@example.com` mints a token the real
# verifier accepts. That route exists only under Rails.env.development?.

# ── Database ───────────────────────────────────────────────────────────
# UNSET = SQLite, embedded, nothing to run. Six files in the storage volume
# (primary, cache, queue, cable, metrics, hep). This is the default and it is
# a complete deployment: `docker run` and you are done.
#
# SET = the PRIMARY database moves to Postgres — orgs, users, accounts,
# memberships, servers, and the encrypted PATs. Point it at your own instance,
# local or across the network. That is the whole switch; there is no mode to
# turn on beside it.
#
# DATABASE_URL=postgres://voodu:secret@10.0.0.5:5432/voodu

# What moves and what does not:
#
#   primary  -> Postgres      the control plane, the part you cannot lose
#   cache    -> SQLite        sessions and cache; high churn, disposable
#   queue    -> SQLite        pending jobs
#   cable    -> SQLite        ephemeral by nature
#   metrics  -> SQLite        31-day telemetry, refills itself from the poller
#   hep      -> SQLite        31-day SIP capture, same
#
# The warehouse stays on SQLite on purpose, not for lack of effort: those two
# databases are built on ground only SQLite has (generated columns computed
# with json_extract and strftime, a REGEXP operator registered on the
# connection, COLLATE NOCASE). Postgres could not create those tables at all.
#
# So THE VOLUME IS STILL REQUIRED. Losing it costs the telemetry window (which
# the poller rebuilds), the sessions (everyone signs in again) and any pending
# job. It does not cost an org, a user or a PAT — those are in Postgres.
#
# First boot creates everything: the entrypoint runs `rails db:prepare`, which
# creates the Postgres database if the role may (CREATEDB) and loads the schema
# into it, then creates the five SQLite files. Pre-create the database by hand
# if you would rather not grant CREATEDB.

# ── Plan (Enterprise licence) ──────────────────────────────────────────
# UNSET = the free tier, and it is a complete product: one account, one org,
# one operator, and whatever window VOODU_RETENTION_DAYS keeps.
#
# A licence lifts those limits. It is a signed token verified OFFLINE — the
# public key ships in the image and nothing here ever calls home, so this works
# in a closed network and our uptime is not part of your risk.
#
# VOODU_LICENSE=eyJhbGciOiJSUzI1NiJ9...
# VOODU_LICENSE_FILE=/rails/storage/license.jwt

# An absent, malformed or lapsed licence NEVER stops the app. It drops to the
# free tier and says so in /ops/license. Expiry has a 30-day grace period,
# and after it the only things that change are: no new orgs, no new invitations,
# and the searchable window narrows. Nothing is deleted, and a Postgres control
# plane keeps being read — losing access to your own data is not a licence
# term we are willing to enforce.

# ── Retention ──────────────────────────────────────────────────────────
# How many days of logs stay ON DISK. Yours to set, and never touched by the
# licence: an entitlement that could shrink this would delete your history the
# day a renewal ran late.
#
# The licence caps how far back you can SEARCH, which is a different number.
# Free tier searches 3 days; a licence raises that. Buying the entitlement does
# not silently start consuming your disk — raise this too if you want the
# window to be real.
#
# VOODU_RETENTION_DAYS=90

# ── App ────────────────────────────────────────────────────────────────
SOLID_QUEUE_IN_PUMA=1
LOG_TAIL_ENABLED=1
POLLER_SPAWN=1
POLLER_INTERVAL_SECONDS=15
# Per-pod log backfill cap: how far back a pod resumes on restart.
POLLER_LOG_BACKFILL_SECONDS=86400
# Auto-generated and persisted in the storage volume when unset.
# POLLER_TOKEN=
